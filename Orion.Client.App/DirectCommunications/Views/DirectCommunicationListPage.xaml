<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Client.App.DirectCommunications.Views.DirectCommunicationListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orion.Client.App.DirectCommunications.Views"
    xmlns:viewmodel="using:Orion.Client.App.DirectCommunications.ViewModels"
    xmlns:model="using:Orion.Client.App.DirectCommunications.Models"
    xmlns:messageviews="using:Orion.Client.App.Messages.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <viewmodel:DirectCommunicationListViewModel x:Name="Model" />
    </Page.DataContext>
    
    <Grid Padding="15" Background="#000">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <ListView Grid.Column="0" ItemsSource="{x:Bind Model.Items, Mode=OneWay}" SelectedItem="{x:Bind Model.Selected, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:DirectCommunication">
                    <TextBlock Text="{x:Bind ReceiverProfile.Username, Mode=OneWay}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <messageviews:MessageListPage Grid.Column="1" Messages="{x:Bind Model.Messages, Mode=OneWay}" DirectCommunication="{x:Bind Model.Selected, Mode=OneWay}" />
    </Grid>
</Page>

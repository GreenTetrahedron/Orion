<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Client.App.DirectCommunications.Views.DirectCommunicationListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orion.Client.App.DirectCommunications.Views"
    xmlns:viewmodel="using:Orion.Client.App.DirectCommunications.ViewModels"
    xmlns:model="using:Orion.Client.App.DirectCommunications.Models"
    xmlns:messageviews="using:Orion.Client.App.Messages.Views"
    xmlns:converters="using:Orion.Client.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#1a1a19">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Name="BoolToVisibilityConverter" />

        <Style TargetType="Grid" x:Key="MainContentGrid">
            <Setter Property="CornerRadius" Value="8 0 0 0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultText}" x:Key="DirectCommunicationProfileThing">
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultText}" x:Key="UserProfileHeader">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CharacterSpacing" Value="10" />
            <Setter Property="Foreground" Value="#ccc" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="StackPanel" x:Key="Header">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="BorderThickness" Value="0 0 0 0.5" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Spacing" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style TargetType="ListView" x:Key="ListView">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="\assets\assets\fonts\roboto-regular.ttf" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate x:DataType="model:DirectCommunication">
                        <TextBlock Style="{StaticResource DirectCommunicationProfileThing}" Text="{x:Bind ReceiverProfile.Username, Mode=OneWay}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    
    <Page.DataContext>
        <viewmodel:DirectCommunicationListViewModel x:Name="Model" />
    </Page.DataContext>
    
    <Grid Style="{StaticResource MainContentGrid}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ListView Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource ListView}" ItemsSource="{x:Bind Model.Items, Mode=OneWay}" SelectedItem="{x:Bind Model.Selected, Mode=TwoWay}" />

        <StackPanel Grid.Column="1" Grid.Row="0" Style="{StaticResource Header}" Visibility="{x:Bind Path=Model.HasSelected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=ffasdf, Mode=OneWay}">
            <Ellipse Height="25" Width="25">
                <Ellipse.Fill>
                    <ImageBrush Stretch="UniformToFill" ImageSource="/Assets/tim-stief-YFFGkE3y4F8-unsplash.jpg" />
                </Ellipse.Fill>
            </Ellipse>
            
            <TextBlock Style="{StaticResource UserProfileHeader}" Text="{x:Bind Model.Selected.ReceiverProfile.Username, Mode=OneWay}" />
        </StackPanel>

        <messageviews:MessageListPage  Visibility="{x:Bind Path=Model.HasSelected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=true, Mode=OneWay}" Grid.Column="1" Grid.Row="1" Messages="{x:Bind Model.Messages, Mode=OneWay}" DirectCommunication="{x:Bind Model.Selected, Mode=OneWay}" />
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Client.App.DirectCommunications.Views.DirectCommunicationListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orion.Client.App.DirectCommunications.Views"
    xmlns:viewmodel="using:Orion.Client.App.DirectCommunications.ViewModels"
    xmlns:model="using:Orion.Client.App.DirectCommunications.Models"
    xmlns:messageviews="using:Orion.Client.App.Messages.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#1a1a19">

    <Page.Resources>
        <Style TargetType="Grid" x:Key="MainContentGrid">
            <Setter Property="CornerRadius" Value="8 0 0 0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultText}" x:Key="DirectCommunicationProfileThing">
            <Setter Property="FontSize" Value="12" />
        </Style>
        
        <Style TargetType="ListView" x:Key="ListView">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="\assets\assets\fonts\roboto-regular.ttf" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate x:DataType="model:DirectCommunication">
                        <TextBlock Style="{StaticResource DirectCommunicationProfileThing}" Text="{x:Bind ReceiverProfile.Username, Mode=OneWay}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    
    <Page.DataContext>
        <viewmodel:DirectCommunicationListViewModel x:Name="Model" />
    </Page.DataContext>
    
    <Grid Style="{StaticResource MainContentGrid}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView Grid.Column="0" Style="{StaticResource ListView}" ItemsSource="{x:Bind Model.Items, Mode=OneWay}" SelectedItem="{x:Bind Model.Selected, Mode=TwoWay}" />

        <messageviews:MessageListPage Grid.Column="1" Messages="{x:Bind Model.Messages, Mode=OneWay}" DirectCommunication="{x:Bind Model.Selected, Mode=OneWay}" />
    </Grid>
</Page>

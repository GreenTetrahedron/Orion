<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Client.App.DirectCommunications.Views.DirectCommunicationListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orion.Client.App.DirectCommunications.Views"
    xmlns:viewmodel="using:Orion.Client.App.DirectCommunications.ViewModels"
    xmlns:model="using:Orion.Client.App.DirectCommunications.Models"
    xmlns:messageviews="using:Orion.Client.App.Messages.Views"
    xmlns:converters="using:Orion.Client.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#1a1a19">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Name="BoolToVisibilityConverter" />
        <converters:UsernameToAbbreviationConverter x:Name="UsernameToAbbreviationConverter" />
        <converters:StringPrefixConverter x:Name="StringPrefixConverter" />


        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultText}" x:Key="UserProfilePhoto">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Grid" x:Key="UserProfilePhotoContainer">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="#303030" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>

        <Style TargetType="Grid" x:Key="MainContentGrid">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#202020" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultText}" x:Key="DirectCommunicationProfileThing">
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultText}" x:Key="UserProfileHeader">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CharacterSpacing" Value="10" />
            <Setter Property="Foreground" Value="#ccc" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="StackPanel" x:Key="Header">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="BorderThickness" Value="0 0 0 0.5" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Spacing" Value="5" />
            <Setter Property="Padding" Value="10 0" />
        </Style>

        <Style TargetType="ListView" x:Key="ListView">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="\assets\assets\fonts\roboto-regular.ttf" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate x:DataType="model:DirectCommunication">
                        <TextBlock Style="{StaticResource DirectCommunicationProfileThing}" Text="{x:Bind ReceiverProfile.Username, Converter={StaticResource StringPrefixConverter}, ConverterParameter='15', Mode=OneWay}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Grid" x:Key="ChatHeaderContainer">
            <Setter Property="Padding" Value="20 10 10 10" />
            
        </Style>

        <Style TargetType="Button" x:Key="AddDirectCommunicationButton" BasedOn="{StaticResource DefaultButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="ChatHeaderText" BasedOn="{StaticResource DefaultText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="Popup" x:Name="AddDirectCommunicationPopupStyle">
            <Setter Property="IsLightDismissEnabled" Value="True" />
            <Setter Property="CanDrag" Value="False" />
            <Setter Property="VerticalOffset" Value="10" />
            <Setter Property="HorizontalOffset" Value="180" />
        </Style>
    </Page.Resources>
    
    <Page.DataContext>
        <viewmodel:DirectCommunicationListViewModel x:Name="Model" />
    </Page.DataContext>
    
    <Grid Style="{StaticResource MainContentGrid}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Popup x:Name="AddDirectCommunicationPopup" Style="{StaticResource AddDirectCommunicationPopupStyle}">
            <local:AddDirectCommunicationPage OnAddDirectCommunicationSuccessful="OnAddDirectCommunicationSuccessful" Model="{x:Bind Model.AddDirectCommunicationViewModel, Mode=OneWay}"/>
        </Popup>
        
        <StackPanel>
            <Grid Style="{StaticResource ChatHeaderContainer}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Style="{StaticResource ChatHeaderText}" Text="Direct Messages" />
                <Button Grid.Column="1" Content="+" Style="{StaticResource AddDirectCommunicationButton}" Click="OnAddDirectCommunication" />
            </Grid>
            <Rectangle HorizontalAlignment="Stretch" Height="0.5" Fill="#ccc" />

            <ListView Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource ListView}" ItemsSource="{x:Bind Model.Items, Mode=OneWay}" SelectedItem="{x:Bind Model.Selected, Mode=TwoWay}" />
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <StackPanel Style="{StaticResource Header}" Visibility="{x:Bind Path=Model.HasSelected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=ffasdf, Mode=OneWay}">
                <Grid Style="{StaticResource UserProfilePhotoContainer}">
                    <TextBlock Style="{StaticResource UserProfilePhoto}" Text="{x:Bind Model.Selected.ReceiverProfile.Username, Converter={StaticResource UsernameToAbbreviationConverter}, Mode=OneWay}" />
                </Grid>

                <TextBlock Style="{StaticResource UserProfileHeader}" Text="{x:Bind Model.Selected.ReceiverProfile.Username, Mode=OneWay}" />
            </StackPanel>

            <messageviews:MessageListPage Visibility="{x:Bind Path=Model.HasSelected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=true, Mode=OneWay}" Grid.Row="1" Model="{x:Bind Model.MessageListViewModel, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>

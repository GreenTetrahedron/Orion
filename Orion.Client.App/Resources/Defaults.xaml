<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orion.Client.App">

    <x:String x:Key="Darkest">#29272C</x:String>
    <x:String x:Key="SecondDarkest">#2C282F</x:String>
    <x:String x:Key="ThirdDarkest">#2E2B31</x:String>
    <x:String x:Key="Light">#353948</x:String>
    <x:String x:Key="Lighter">#3F4759</x:String>
    <x:String x:Key="Teal">#70D6FF</x:String>
    <x:String x:Key="Blue">#446DF6</x:String>
    <x:String x:Key="Red">#DA4167</x:String>
    
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Assets/Fonts/static/NotoSans-Regular.ttf#Noto Sans</FontFamily>

    <Style TargetType="TextBlock" x:Key="DefaultTextBlock">
        <Setter Property="Foreground" Value="#fff"/>
        <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}"/>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}">
        
    </Style>

    <Style TargetType="TextBlock" x:Key="InvalidMessage" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Red}"/>
    </Style>

</ResourceDictionary>

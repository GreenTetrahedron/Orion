<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Client.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orion.Client.App"
    xmlns:grouplocal="using:Orion.Client.App.Groups.Views"
    xmlns:groupviewmodel="using:Orion.Client.App.Groups.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <groupviewmodel:GroupsListViewModel x:Name="GroupListViewModel" />
    </Page.DataContext>
    
    <Grid Background="#1a1a19">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Frame Grid.Column="0" x:Name="navigationFrame" />
            <grouplocal:GroupsListPage Model="{x:Bind GroupListViewModel, Mode=OneWay}" />
        </StackPanel>
        <Frame Grid.Column="1" x:Name="contentFrame" />
    </Grid>
</Page>

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orion.Client.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <StackPanel Padding="0 0 0 0" Spacing="15" Width="75" Background="#1a1a19">
        <Button HorizontalAlignment="Center" FontSize="10" Height="47" Width="47" Click="LoadDirectCommunicationListPage">
            DMs
        </Button>
        <Button HorizontalAlignment="Center" FontSize="10" Height="47" Width="47" Click="LoadAddDirectCommunicationPage">
            + DM
        </Button>
    </StackPanel>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Server.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orion.Server.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style TargetType="Frame" x:Name="MainContent">
            <Setter Property="CornerRadius" Value="8 0 0 0" />
        </Style>
    </Page.Resources>
    
    <Grid Background="#1a1a19">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Frame Grid.Column="0" x:Name="navigationFrame" />
        <Frame Style="{StaticResource MainContent}" Grid.Column="1" x:Name="contentFrame" />
    </Grid>
</Page>

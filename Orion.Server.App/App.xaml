<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Orion.Server.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orion.Server.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock" x:Key="DefaultText">
                <Setter Property="FontFamily" Value="\assets\assets\fonts\#Roboto" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style TargetType="TextBox" x:Key="DefaultTextBox">
                <Setter Property="FontFamily" Value="\assets\assets\fonts\#Roboto" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style TargetType="PasswordBox" x:Key="DefaultPasswordBox">
                <Setter Property="FontFamily" Value="\assets\assets\fonts\#Roboto" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style TargetType="Button" x:Key="DefaultButton">
                <Setter Property="FontFamily" Value="\assets\assets\fonts\#Roboto" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style TargetType="StackPanel" x:Name="Form">
                <Setter Property="Spacing" Value="25" />
                <Setter Property="MinWidth" Value="200" />
                <Setter Property="Background" Value="#ff262626" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}" x:Key="SubmitButton">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Background" Value="#ff333333" />
            </Style>

            <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultText}" x:Name="FormLabel">
                <Setter Property="FontWeight" Value="Light" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}" x:Name="FormTextBox">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="10 10" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#ff333333" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            
            <Style TargetType="Grid" x:Name="FullPagePopupContent">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="#ff262626" />
                <Setter Property="Opacity" Value="100" />
                <Setter Property="Padding" Value="30 20 20 20" />
                <Setter Property="RowSpacing" Value="25" />
                <Setter Property="ColumnSpacing" Value="5" />
                <Setter Property="MinWidth" Value="400" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}" x:Name="PopupCloseButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Height" Value="27" />
                <Setter Property="Width" Value="27" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />

                <Setter Property="FontSize" Value="27" />
                <Setter Property="FontWeight" Value="Light" />
            </Style>
            <Style TargetType="Border" x:Name="PopupBorder">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="#5f000000" />
            </Style>


            <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultText}" x:Name="PageTitle">
                <Setter Property="FontSize" Value="40" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource PageTitle}" x:Key="PopupTitle">
                <Setter Property="FontSize" Value="27" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Server.App.Users.Views.UserForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orion.Server.App.Users.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <StackPanel>
        <TextBlock Text="Username" />
        <TextBox x:Name="usernameTextEntry" />

        <TextBlock Text="Password" />
        <TextBox x:Name ="passwordTextEntry" />
        
        <ComboBox x:Name="rolesComboBox" Header="Role" ItemsSource="{x:Bind Roles}"></ComboBox>

        <Button Click="OnSubmitClicked">Submit</Button>
    </StackPanel>
</Page>

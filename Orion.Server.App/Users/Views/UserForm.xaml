<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Server.App.Users.Views.UserForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Orion.Server.App.Users.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style TargetType="ComboBox" x:Key="FormComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontFamily" Value="\assets\assets\fonts\#Roboto" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
    </Page.Resources>
    
    <StackPanel Style="{StaticResource Form}">
        <StackPanel>
            <TextBlock Style="{StaticResource FormLabel}" Text="Username" />
            <TextBox Style="{StaticResource FormTextBox}" x:Name="usernameTextEntry" Text="{x:Bind User.Username, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel>
            <TextBlock Style="{StaticResource FormLabel}" Text="Password (leave blank to not change)" />
            <TextBox Style="{StaticResource FormTextBox}" x:Name ="passwordTextEntry" Text="{x:Bind User.Password, Mode=TwoWay}" />
        </StackPanel>
        
        <ComboBox Style="{StaticResource FormComboBox}" x:Name="rolesComboBox" Header="Role" ItemsSource="{x:Bind Roles}" SelectedItem="{x:Bind User.Role, Mode=TwoWay}"></ComboBox>

        <Button Style="{StaticResource SubmitButton}" Click="OnSubmitClicked">Submit</Button>
    </StackPanel>
</Page>
